# Copy this example to .env for local use; never commit .env.
# Do not import the entire .env file into Netlify.
# Register only the SMTP runtime keys in Netlify UI; select Functions scope if your plan offers scopes.
# The local loader preserves environment variables already provided by the shell.

# SMTP runtime — SMTP_USER and SMTP_PASS are required for contact email.
# CONTACT_TO defaults to SMTP_USER; SMTP_FROM has the existing sender fallback.
CONTACT_TO=
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Optional SMTP settings; defaults preserve the existing mailer behavior.
SMTP_REQUIRE_TLS=true
SMTP_EHLO_DOMAIN=nero.ai.kr

# Optional Netlify CLI credentials — local deployment tooling only.
# Do not register these as browser, build or contact Function runtime variables.
NETLIFY_AUTH_TOKEN=
NETLIFY_SITE_ID=

# Optional separate Firebase infrastructure — not used by this website's current runtime.
# Keep existing project settings only if another workflow still needs them.
FIREBASE_PROJECT_ID=
FIRESTORE_DATABASE_ID=
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Public ownership verification values — use only values issued to the owner.
# These are public HTML metadata values, not account credentials. Used only by the build.
# Select Builds scope if available; scope controls are not required for this implementation.
# Leave blank until issued; blank values must not render verification tags.
NERO_GOOGLE_SITE_VERIFICATION=
NERO_NAVER_SITE_VERIFICATION=
NERO_BING_SITE_VERIFICATION=

# Optional local server settings can be passed through the shell.
# HOST, PORT, PORT_SCAN_LIMIT
