# Optional Firebase values for separate Firebase integrations.
FIREBASE_PROJECT_ID=
FIRESTORE_DATABASE_ID=nero-web-db
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Netlify Functions: Gmail SMTP contact email delivery.
CONTACT_TO=
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
# Use a Google App Password, not the normal Gmail account password.
SMTP_PASS=
SMTP_FROM=
